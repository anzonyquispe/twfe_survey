\multirow{2}{*}{\begin{minipage}[b]{\linewidth}\raggedright
Pr
\end{minipage}} &
\multirow{2}{*}{\begin{minipage}[b]{\linewidth}\raggedright
\emph{δS∈CI}1\emph{−α}(\emph{δS})
\end{minipage}} &
\multirow{2}{*}{\begin{minipage}[b]{\linewidth}\raggedright
\begin{quote}
\emph{≥}1 \emph{−α.}
\end{quote}
\end{minipage}} \\
\begin{minipage}[b]{\linewidth}\raggedright
