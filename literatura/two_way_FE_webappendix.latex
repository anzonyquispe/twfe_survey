\textbf{Assumption S7} \emph{(Common trends) For every d, for all t ≥}2
\emph{and g, E}(\emph{Yg,t}(\emph{d}) \emph{−Yg,t−}1(\emph{d}))
\emph{does not vary across g.}

\textbf{Assumption S8} \emph{(Existence of ``stable'' groups) For all t
∈\{}2\emph{, ..., T\}, for all} (\emph{d, d′}) \emph{∈D}2\emph{, d ̸}=
\emph{d′, if there is at least one g ∈\{}1\emph{, ..., G\} such that
