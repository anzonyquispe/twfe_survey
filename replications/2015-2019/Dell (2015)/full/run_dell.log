. capture program drop makestars

. program define makestars, rclass
  1.         syntax , Pointest(real) PVal(real) [bdec(integer 3)]
  2.         local fullfloat = `bdec' + 1
  3.         local outstr = string(`pointest',"%`fullfloat'.`bdec'f")
  4.         if `pval' <= 0.01 {
  5.                 local outstr = "`outstr'" + "***"
  6.         }
  7.         else if `pval' <= 0.05 {
  8.                 local outstr = "`outstr'" + "**"
  9.         }
 10.         else if `pval' <= 0.1 {
 11.                 local outstr = "`outstr'" + "*"
 12.         }
 13.         return local coeff = "`outstr'"
 14. end

