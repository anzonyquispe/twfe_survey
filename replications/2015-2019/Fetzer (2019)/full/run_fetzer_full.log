  3. 
.     preserve
  4.     local shorter = substr("`var'", 1, 20)
  5.     forvalues i=1(1)16 {
  6.         gen yyin_`shorter'_`i' = yy_`i' * `var'
  7.     }
  8. 
.     cap noi reghdfe pct_votes_UKIP yyin_`shorter'_1- yyin_`shorter'_10 yyin_`
> shorter'_12-yyin_`shorter'_16, absorb(id ryr) vce(cl id)
  9. 
.     if _rc==0 {
 10.         di _n "  Post-2010 coefficients:"
 11.         forvalues i=12(1)16 {
 12.             cap noi lincom yyin_`shorter'_`i'
 13.             if _rc==0 {
