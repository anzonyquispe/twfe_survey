. 
. * Conditional on not getting tenure at policy university
. foreach depvar in down up {
  2.     di _n "--- `depvar' (cond. no tenure) ---"
  3.     cap noi xi: reg `depvar' `plist' `ulist' i.pol_job_start*i.female i.fe
> male*i.pol_u if tenure_p==0, cluster(pol_u)
  4.     cap noi lincom focs
  5.     cap noi lincom focs+f_focs
  6.     cap noi lincom gncs
  7.     cap noi lincom gncs+f_gncs
  8.     cap noi lincom -f_focs
  9.     cap noi lincom -f_gncs
 10. }

