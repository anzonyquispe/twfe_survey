. * Conditional on tenure anywhere
. foreach depvar in time_to_tenure jobs_to_associate {
  2.     di _n "--- `depvar' (cond. tenure) ---"
  3.     xi: reg `depvar' `plist' `ulist' i.pol_job_start*i.female i.female*i.p
> ol_u, cluster(pol_u)
  4.     lincom focs
  5.     lincom focs+f_focs
  6.     lincom gncs
  7.     lincom gncs+f_gncs
  8.     lincom -f_focs
  9.     lincom -f_gncs
 10. }

