(474 real changes made)

. 
. quietly summ yhat if (strfc & ttlDur<=2007 & e(sample)), d

. gen lbar = r(p1)

. gen lbar2 = r(p5)

. quietly summ yhat if (nsrfc & ttlDur<=2007 & e(sample)), d

. gen ubar = r(p99)

. gen ubar2 = r(p95)

. gen match_samp1 = ((yhat > lbar) & (yhat < ubar))

. gen match_samp2 = ((yhat > lbar2) & (yhat < ubar2))

. 
. drop ubar* lbar* yhat

