. di _n "===== TABLE 5: Placebo 2003 ====="

===== TABLE 5: Placebo 2003 =====

. 
. local cond "if Sample==1"

. local clust "cluster(region)"

. qui areg Votes_SPS_2003 Watch_probit $socioec $vote95 `cond', absorb(region) 
> robust

. cap drop sample

. gen sample = e(sample)

. local cond "if sample==1"

. 
. foreach var in $vote03 {
  2.     di _n "--- `var' without controls ---"
  3.     areg `var' Watch_probit $socioec $vote95 `cond', absorb(region) robust
>  `clust'
  4. 
.     di _n "--- `var' no vote95 ---"
  5.     areg `var' Watch_probit $socioec `cond', absorb(region) robust `clust'
  6. 
.     di _n "--- `var' with vote99 ---"
  7.     areg `var' Watch_probit $socioec $vote99 `cond', absorb(region) robust
>  `clust'
  8. }

