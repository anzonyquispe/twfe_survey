. if _rc ssc install twowayfeweights, replace

. 
. * Helper program: significance stars from t-stat
. cap program drop _stars

. program define _stars, rclass
  1.     args b se
  2.     local s ""
  3.     if `se' > 0 & `se' < . {
  4.         local t = abs(`b'/`se')
  5.         if `t' > 2.576      local s "***"
  6.         else if `t' > 1.960 local s "**"
  7.         else if `t' > 1.645 local s "*"
  8.     }
  9.     return local s "`s'"
 10. end

