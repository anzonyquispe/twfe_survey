. cap noi do "$prog/taxsim-eitc.do"

. *****Prepare data for calculation of EITC, send to TAXSIM, and create dataset
>  for IV
. 
. *****Setup
. 
. *Baseline without state
. **001 is wage income only
. **002 is wage plus unearned income
. **012, 011 include state taxes and credits
. 
. foreach j in 012 011 211 311 411 511 611 711 {
  2. 
. ***KEY to datasets***
. *hat=0: real data, hat=4: baseline predicted, hat=2,3 needed for Table 4, hat
> =5,6,7 needed for Table 5
. *state=0: no state tax information calculated, state=1: state taxes included
. *spec=1: excludes unearned income, spec2: includes unearned income
. local hat=substr("`j'",1,1)
  3. local state=substr("`j'",2,1)
  4. local spec=substr("`j'",3,1)
  5. 
. use $data/main, replace
  6. sort idchild year
  7. 
. *IMPORTANT NOTE: all income variables are in 1979 dollars, and need to be con
> verted to nominal dollars before sending through taxsim
. *(convert to nominal dollars by multiplying by cpily)
. 
. replace earnincrimp=earnincrimp*cpily
  8. replace earnincsimp=earnincsimp*cpily
  9. replace earnincrsimp=earnincrsimp*cpily
 10. replace unearnincrsimp=unearnincrsimp*cpily
 11. replace nontaxincrsimp=nontaxincrsimp*cpily
 12. gen pretaxinc=earnincrsimp+unearnincrsimp+nontaxincrsimp
 13. 
. *****As needed, make variable changes or sample restrictions
. 
. *note: one year already subtracted off to reflect that NLSY reports lagged in
> come
. gen trend=year-1986
 14. 
. ***Set state variable to missing if necessary (for state=0 samples)
. replace state=0 if `state'==0
 15. 
. *****Sample restrictions
. gen samp=1
 16. replace samp = (year==1985|year==1987|year==1989|year==1991|year==1993|yea
> r==1995|year==1997|year==1999) & (piamatsn!=. | piarecsn!=. | piarersn!=.) if
>  `hat'==2 | `hat'==3 | `hat'==4 | `hat'==5
 17. replace samp = samp | (year==1988|year==1990|year==1992|year==1994|year==1
> 996|year==1998) if `hat'==6 | `hat'==7
 18. 
. sort idchild year
 19. xtset idchild year, yearly delta(1)
 20. 
. *create variables for SIV and to define sample
. gen test=(2.295/(10000*cpily))*earnincrsimp
 21. gen x0=L2.test==0
 22. gen x1=L2.test
 23. gen x2=x1^2
 24. gen x3=x1^3
 25. gen x4=x1^4
 26. gen x5=x1^5
 27. 
. gen getdiv02=marrlyimp==0 & (L1.marrlyimp==1|L2.marrlyimp==1)
 28. gen getmarr02=marrlyimp==1 & (L1.marrlyimp==0|L2.marrlyimp==0)
 29. 
. gen flag1 = (2.295/(10000*cpily))*pretaxinc<10 & (2.295/(10000*L2.cpily))*L2.
> pretaxinc<10
 30. gen flag = year>=1989 & !getmarr02 & !getdiv02 & flag1 if `hat'==2 | `hat'
> ==3 | `hat'==4 | `hat'==6 | `hat'==7
 31. replace flag = year>=1987 & !getmarr02 & !getdiv02 & flag1 if `hat'==5
 32. 
. keep if samp
 33. 
. *drop poor oversample
. keep if ((samprandom&sampnm)|sampnmblack|sampnmhisp) | (year==1994|year==1996
> |year==1998)
 34. 
. *****Get predicted income
. 
. *Need to have earned income (for eitc credit) and unearned income (for locati
> on on eitc schedule)
. gen earninc=.
 35. gen unearninc=.
 36. 
. *Use actual data (for hat=0 samples)
. replace earninc=earnincrsimp if `hat'==0
 37. replace unearninc=unearnincrsimp if `hat'==0
 38. 
. *year trend
. if `hat'==2 {
 39.   reg test x0 x1 x2 x3 x4 x5 trend if samp & flag
 40.   predict earninchat if samp & flag
 41.   replace earninc=earninchat*((10000*cpily)/2.295) if samp & flag
 42. }
 43. 
. *year dummies
. if `hat'==3 {
 44.   reg test x0 x1 x2 x3 x4 x5 yy* if samp & flag
 45.   predict earninchat if samp & flag
 46.   replace earninc=earninchat*((10000*cpily)/2.295) if samp & flag
 47. }
 48. 
. *baseline
. if `hat'==4 {
 49.   reg test x0 x1 x2 x3 x4 x5 if samp & flag
 50.   predict earninchat if samp & flag
 51.   replace earninc=earninchat*((10000*cpily)/2.295) if samp & flag
 52. }
 53. 
. *for Table 5
. if `hat'==5 {
 54.   gen f0=F2.test==0
 55.   gen f1=F2.test
 56.   gen f2=f1^2
 57.   gen f3=f1^3
 58.   gen f4=f1^4
 59.   gen f5=f1^5
 60. 
.   reg test f0 f1 f2 f3 f4 f5 if samp & flag
 61.   predict earninchat if samp & flag
 62.   replace earninc=earninchat*((10000*cpily)/2.295) if samp & flag
 63. }
 64. 
. *for Table 5
. if `hat'==6 {
 65.   gen f0=L1.test==0
 66.   gen f1=L1.test
 67.   gen f2=f1^2
 68.   gen f3=f1^3
 69.   gen f4=f1^4
 70.   gen f5=f1^5
 71. 
.   reg test f0 f1 f2 f3 f4 f5 if samp & flag & (year==1987|year==1989|year==19
> 91|year==1993|year==1995|year==1997|year==1999) & (piamatsn!=. | piarecsn!=. 
> | piarersn!=.)
 72.   predict earninchat if samp & flag 
 73.   replace earninc=earninchat*((10000*cpily)/2.295) if samp & flag 
 74. }
 75. 
. *for Table 5
. if `hat'==7 {
 76.   gen f0=F1.test==0
 77.   gen f1=F1.test
 78.   gen f2=f1^2
 79.   gen f3=f1^3
 80.   gen f4=f1^4
 81.   gen f5=f1^5
 82.   
.   reg test f0 f1 f2 f3 f4 f5 if samp & flag & (year==1987|year==1989|year==19
> 91|year==1993|year==1995|year==1997|year==1999) & (piamatsn!=. | piarecsn!=. 
> | piarersn!=.)
 83.   predict earninchat if samp & flag
 84.   replace earninc=earninchat*((10000*cpily)/2.295) if samp & flag
 85. }
 86. 
. gen oldyear=year
 87. 
. *****Replace pwages and ui with predicted values earninc and unearninc and sa
> ve pre-eitc dataset
. 
. replace swages=0
 88. replace pwages=earninc
 89. replace ui=unearninc
 90. 
. *Set non-wage income (unearnincrsimp, which we are feeding through taxsim as 
> "ui") equal to zero if necessary (for spec=1 samples)
. replace ui=0 if `spec'==1
 91. 
. drop earninc unearninc
 92. 
. *Save pre-eitc master dataset, using real data, for later merging in future p
> rogram
. if "`j'"=="012" {
 93.   save $data/preeitcinput, replace
 94. }
 95. 
. keep idchild cpily year state mstat depx agex pwages swages dividends otherpr
> op pensions gssi transfers rentpaid proptax otheritem childcare ui depchild m
> ortgage stcg ltcg oldyear
 96. 
. *Note: don't send idchild to taxsim if using state identifiers
. 
. *****Send data to TAXSIM and get after tax income and EITC
. 
. taxsim9, replace full
 97. 
. replace year=oldyear
 98. 
. sort idchild year
 99. save $data/taxsimout`j', replace
100. 
. }
