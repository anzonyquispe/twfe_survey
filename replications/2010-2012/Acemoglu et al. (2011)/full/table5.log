. * Agriculture: West Elbe, weighted
. foreach X of local timeperiods {
  2.     di _n "--- Table 5, Col 1, year `X' ---"
  3.     reg agric fpresence if year==`X' & imputed==0 & westelbe==1 [aweight=p
> op1849], cl(state)
  4.     if `first' == 1 {
  5.         outreg2 fpresence using "$outdir/table5_results.xls", br noaster c
> title("T5 C1 yr`X'") replace
  6.         local first = 0
  7.     }
  8.     else {
  9.         outreg2 fpresence using "$outdir/table5_results.xls", br noaster c
> title("T5 C1 yr`X'")
 10.     }
 11. }

