. 
. * --- Wave 2 ---------------------------------------------------------------
. forvalues i = 1/`n2' {
  2.     local wave   : word `i' of `waves2'
  3.     local folder : word `i' of `folders2'
  4.     local dta    "$twfe_root/replications/`wave'/`folder'/panel_GTD.dta"
  5. 
.     local j = `n1' + `i'
  6.     di _n as text "================================================================"
  7.     di    as text "  [`j'/21] `folder' (`wave')"
  8.     di    as text "================================================================"
  9. 
.     * ---- classify_did -------------------------------------------------------
.     local des   "FAILED"
 10.     local est   ""
 11.     local code  = -1
 12.     local hs    = 0
 13. 
.     cap noisily {
 14.         use "`dta'", clear
 15.         classify_did Y G T D
 16.         local des  "`r(design)'"
 17.         local est  "`r(estimator)'"
 18.         local code  = r(design_code)
 19.         local hs    = r(had_stayers)
 20.     }
 21.     if _rc {
 22.         di as error "  --> classify_did failed (rc=`_rc')"
 23.         local des   "FAILED"
 24.         local est   ""
 25.         local code  = -1
 26.         local hs    = 0
 27.     }
 28. 
.     * ---- classify_sketch2 --------------------------------------------------
.     local des2   "FAILED"
 29.     local est2   ""
 30.     local code2  = -1
 31.     local hs2    = 0
 32. 
.     cap noisily {
 33.         use "`dta'", clear
 34.         classify_sketch2 Y G T D
 35.         local des2  "`r(design)'"
 36.         local est2  "`r(estimator)'"
 37.         local code2  = r(design_code)
 38.         local hs2    = r(had_stayers)
 39.     }
 40.     if _rc {
 41.         di as error "  --> classify_sketch2 failed (rc=`_rc')"
 42.         local des2   "FAILED"
 43.         local est2   ""
 44.         local code2  = -1
 45.         local hs2    = 0
 46.     }
 47. 
.     post handle                                                     ///
>         ("`folder'") ("`wave'")                                     ///
>         ("`des'")  (`code')  (`hs')  ("`est'")                     ///
>         ("`des2'") (`code2') (`hs2') ("`est2'")
 48. }

