. 
. * --------------------------------------------------------------------------
. * Paper list  (wave | folder-relative path | display name)
. * --------------------------------------------------------------------------
. 
. * Wave 1: 2010–2012  (Acemoglu, Bagwell, Simcoe excluded)
. local waves    "2010-2012 2010-2012 2010-2012 2010-2012 2010-2012 2010-2012 2010-2012 2010-2012 2010-2012 2010-2012 2010-2012 2010-2012 2010
> -2012"

. local folders  `""Algan and Cahuc (2010)" "Baum-SnowandLutz(2011)" "Besley and Mueller (2012)" "Dinkelman (2011)" "Duranton and Turner (2011
> )" "Enikolopov et al. (2011)" "Faye and Niehaus (2012)" "Forman et al. (2012)" "Gentzkow et al. (2011)" "Hornbeck (2012)" "Moser and Voena (
> 2012)" "Wang (2011)" "Zhang and Zhu (2011)""'

. local n1 = 13

. 
. * Wave 2: 2015–2019
. local waves2   "2015-2019 2015-2019 2015-2019 2015-2019 2015-2019 2015-2019 2015-2019 2015-2019"

. local folders2 `""Antecol et al. (2018)" "Berman et al. (2017)" "Burgess et al. (2015)" "Donaldson (2018)" "Favara and Imbs (2015)" "Fetzer 
> (2019)" "Kaur (2019)" "Suárez Serrato and Zidar (2016)""'

. local n2 = 8

. 
. * --------------------------------------------------------------------------
. * postfile: one row per paper, results from both classifiers
. * --------------------------------------------------------------------------
. tempfile tmp

. postfile handle                 ///
>     str60  paper                ///
>     str10  wave                 ///
>     str30  design               ///
>     int    design_code          ///
>     byte   had_stayers          ///
>     str30  estimator            ///
>     str30  design_s2            ///
>     int    design_code_s2       ///
>     byte   had_stayers_s2       ///
>     str30  estimator_s2         ///
>     using `tmp', replace
(file /var/folders/gb/56xms55d53n734tnp7xq55bh0000gq/T//S_06260.000001 not found)

. 
. * --------------------------------------------------------------------------
. * Helper macro: run both classifiers for one paper
. * --------------------------------------------------------------------------
. * (called inline in each forvalues loop — Stata macros can't be subroutines,
. *  so we repeat the block; both loops are identical except for the counter)
. 
. * --- Wave 1 ---------------------------------------------------------------
. forvalues i = 1/`n1' {
  2.     local wave   : word `i' of `waves'
  3.     local folder : word `i' of `folders'
  4.     local dta    "$twfe_root/replications/`wave'/`folder'/panel_GTD.dta"
  5. 
.     di _n as text "================================================================"
  6.     di    as text "  [`i'/21] `folder' (`wave')"
  7.     di    as text "================================================================"
  8. 
.     * ---- classify_did -------------------------------------------------------
.     local des   "FAILED"
  9.     local est   ""
 10.     local code  = -1
 11.     local hs    = 0
 12. 
.     cap noisily {
 13.         use "`dta'", clear
 14.         classify_did Y G T D
 15.         local des  "`r(design)'"
 16.         local est  "`r(estimator)'"
 17.         local code  = r(design_code)
 18.         local hs    = r(had_stayers)
 19.     }
 20.     if _rc {
 21.         di as error "  --> classify_did failed (rc=`_rc')"
 22.         local des   "FAILED"
 23.         local est   ""
 24.         local code  = -1
 25.         local hs    = 0
 26.     }
 27. 
.     * ---- classify_sketch2 --------------------------------------------------
.     local des2   "FAILED"
 28.     local est2   ""
 29.     local code2  = -1
 30.     local hs2    = 0
 31. 
.     cap noisily {
 32.         use "`dta'", clear
 33.         classify_sketch2 Y G T D
 34.         local des2  "`r(design)'"
 35.         local est2  "`r(estimator)'"
 36.         local code2  = r(design_code)
 37.         local hs2    = r(had_stayers)
 38.     }
 39.     if _rc {
 40.         di as error "  --> classify_sketch2 failed (rc=`_rc')"
 41.         local des2   "FAILED"
 42.         local est2   ""
 43.         local code2  = -1
 44.         local hs2    = 0
 45.     }
 46. 
.     post handle                                                     ///
>         ("`folder'") ("`wave'")                                     ///
>         ("`des'")  (`code')  (`hs')  ("`est'")                     ///
>         ("`des2'") (`code2') (`hs2') ("`est2'")
 47. }

