> 12/Acemoglu et al. (2011)/run_twowayfe.log
  log type:  text
 opened on:  24 May 2026, 23:31:14

. 
. * Install packages if needed
. cap which twowayfeweights

. if _rc ssc install twowayfeweights, replace

. cap which gtools

. if _rc ssc install gtools, replace

. 
. * Helper program: significance stars
. cap program drop _stars

. program define _stars, rclass
  1.     args b se
  2.     local s ""
  3.     if `se' > 0 & `se' < . {
  4.         local t = abs(`b'/`se')
  5.         if `t' > 2.576      local s "***"
  6.         else if `t' > 1.960 local s "**"
  7.         else if `t' > 1.645 local s "*"
  8.     }
  9.     return local s "`s'"
 10. end

. 
