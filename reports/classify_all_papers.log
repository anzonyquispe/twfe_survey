. 
. * --- Helper program for significance stars ---
. cap program drop _stars

. program define _stars, rclass
  1.     args b se
  2.     local s ""
  3.     if `se' > 0 & `se' < . {
  4.         local t = abs(`b'/`se')
  5.         if `t' > 2.576      local s "***"
  6.         else if `t' > 1.960 local s "**"
  7.         else if `t' > 1.645 local s "*"
  8.     }
  9.     return local s "`s'"
 10. end

. 
. * --- Extract stored estimates ---
. forvalues k = 1/5 {
  2.     cap estimates restore col`k'
  3.     if !_rc {
  4.         local n`k' = e(N)
  5.         local r2_`k' : di %4.2f e(r2_a)
  6. 
.         * Post × Δ
.         local b1_`k' = _b[_IregXlog_m_1]
  7.         local se1_`k' = _se[_IregXlog_m_1]
  8.         * Post
.         local b2_`k' = _b[_Iregime2_1]
  9.         local se2_`k' = _se[_Iregime2_1]
 10.         * Δ
.         local b3_`k' = _b[log_mismatchpre]
 11.         local se3_`k' = _se[log_mismatchpre]
 12. 
.         * Year dummies (relative to base year 1989)
.         foreach yr in 1991 1993 1997 2000 2004 {
 13.             cap local b_yr`yr'_`k' = _b[_Iyear_`yr']
 14.             if _rc local b_yr`yr'_`k' = .
 15.             cap local se_yr`yr'_`k' = _se[_Iyear_`yr']
 16.             if _rc local se_yr`yr'_`k' = .
 17.         }
 18.     }
 19.     else {
 20.         local n`k' = 0
 21.     }
 22. }

