. file write texfile " + \beta_1 \tau_{gc}^{BR} + \beta_2 V_{gc}^{BR} + \epsilo
> n_{gc}\$." _n

. file write texfile " *** Significant at the 1 percent level," _n

. file write texfile " ** 5 percent level, * 10 percent level.}" _n

