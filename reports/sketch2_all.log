. * --- Wave 2 ---------------------------------------------------------------
. forvalues i = 1/`n2' {
  2.     local wave   : word `i' of `waves2'
  3.     local folder : word `i' of `folders2'
  4.     local dta    "$panels_GTD/`wave'/`folder'/panel_GTD.dta"
  5.     local j = `n1' + `i'
  6. 
.     di _n as text "================================================================"
  7.     di    as text "  [`j'/21] `folder' (`wave')"
  8.     di    as text "================================================================"
  9. 
.     local des   "FAILED"
 10.     local est   ""
 11.     local code  = -1
 12.     local hs    = 0
 13. 
.     cap noisily {
 14.         use "`dta'", clear
 15.         classify_sketch2 Y G T D
 16.         local des  "`r(design)'"
 17.         local est  "`r(estimator)'"
 18.         local code  = r(design_code)
 19.         local hs    = r(had_stayers)
 20.     }
 21.     if _rc {
 22.         di as error "  --> classify_sketch2 failed (rc=`_rc')"
 23.         local des   "FAILED"
 24.         local est   ""
 25.         local code  = -1
 26.         local hs    = 0
 27.     }
 28. 
.     post handle ("`folder'") ("`wave'") ("`des'") (`code') (`hs') ("`est'")
 29. }

