. 
. * --------------------------------------------------------------------------
. * postfile: one row per paper
. * --------------------------------------------------------------------------
. tempfile tmp

. postfile handle         ///
>     str60  paper        ///
>     str10  wave         ///
>     str30  design       ///
>     int    design_code  ///
>     byte   had_stayers  ///
>     str30  estimator    ///
>     using `tmp', replace
(file /var/folders/gb/56xms55d53n734tnp7xq55bh0000gq/T//S_06260.000001 not found)

. 
. * --- Wave 1 ---------------------------------------------------------------
. forvalues i = 1/`n1' {
  2.     local wave   : word `i' of `waves1'
  3.     local folder : word `i' of `folders1'
  4.     local dta    "$panels_GTD/`wave'/`folder'/panel_GTD.dta"
  5. 
.     di _n as text "================================================================"
  6.     di    as text "  [`i'/21] `folder' (`wave')"
  7.     di    as text "================================================================"
  8. 
.     local des   "FAILED"
  9.     local est   ""
 10.     local code  = -1
 11.     local hs    = 0
 12. 
.     cap noisily {
 13.         use "`dta'", clear
 14.         classify_sketch2 Y G T D
 15.         local des  "`r(design)'"
 16.         local est  "`r(estimator)'"
 17.         local code  = r(design_code)
 18.         local hs    = r(had_stayers)
 19.     }
 20.     if _rc {
 21.         di as error "  --> classify_sketch2 failed (rc=`_rc')"
 22.         local des   "FAILED"
 23.         local est   ""
 24.         local code  = -1
 25.         local hs    = 0
 26.     }
 27. 
.     post handle ("`folder'") ("`wave'") ("`des'") (`code') (`hs') ("`est'")
 28. }

